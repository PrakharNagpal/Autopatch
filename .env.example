# Devin API — personal key from app.devin.ai/settings/api-keys
DEVIN_API_KEY=apk_user_...

# Devin service user token — create in Devin Settings → Service Users
# Needs ManageBilling permission at org level to fetch per-session ACU costs
DEVIN_SERVICE_KEY=cog_...

# ACU → USD rate (Core plan = $2.25, Team plan = $2.00)
ACU_USD_RATE=2.25

# GitHub PAT with repo + issues + pull_requests scopes
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=your-github-username
GITHUB_REPO=superset

# Optional: webhook secret (leave blank to skip HMAC verification in dev)
GITHUB_WEBHOOK_SECRET=

# Budget controls
DAILY_ACU_BUDGET=50
PER_SESSION_ACU_CAP=10

# Absolute path to your local superset fork (used by scanners)
# Docker mounts this at /superset inside the container
SUPERSET_REPO_PATH=/path/to/your/superset-fork
